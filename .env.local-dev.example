# Copy to .env.local-dev and keep local secrets out of git.
PORT=9050
HOST=127.0.0.1

FRONTEND_API_PROXY_TARGET=http://127.0.0.1:9050

MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DB=maimai_web
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=maimai:
BULLMQ_PREFIX=
DXNET_LANE_INTERACTIVE_CONCURRENCY=8
DXNET_LANE_USER_SYNC_CONCURRENCY=16
DXNET_LANE_BACKGROUND_CONCURRENCY=16
SDGB_WORKER_CAPABILITIES=probe,interactive
SDGB_FAKE_UPSTREAM=0

AUTH_JWT_SECRET=change-me-local
WEBAUTHN_RP_NAME=maimai Score Hub (Local)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY_HOPS=0
ADMIN_PASSWORD=change-me-local-admin
API_SHARED_SECRET=change-me-local-admin
SKIP_AUTH=true

OBSERVABILITY_ENABLED=true
OBSERVABILITY_ENV=dev
OBSERVABILITY_INSTANCE=local-admin-dashboard
CLICKHOUSE_URL=http://192.168.1.101:8123
CLICKHOUSE_DATABASE=maimai_observability
CLICKHOUSE_USER=maimai_dev_writer
CLICKHOUSE_PASSWORD=
CLICKHOUSE_FLUSH_INTERVAL_MS=1000
