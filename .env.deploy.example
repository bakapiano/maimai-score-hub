# Copy to .env.deploy.local (gitignored) for local fast deploys via:
#   npm run deploy:frontend
#   npm run deploy:backend
#   npm run deploy:admin
#
# Leave DEPLOY_JUMP empty if you can SSH directly to DEPLOY_HOST.
DEPLOY_HOST=your-prod-host-ip
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_JUMP=
DEPLOY_WEB_ROOT=/var/lib/maimai-score-hub-web
DEPLOY_BACKEND_PATH=/root/maimai-score-hub-backend
