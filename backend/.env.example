# Server
PORT=9050

# MongoDB (requires username + password)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=maimai_web

# If using the root user from docker-compose, authSource should be "admin"
MONGO_USER=root
MONGO_PASSWORD=example
MONGO_AUTH_SOURCE=admin

# Redis / BullMQ
# REDIS_URL takes precedence over host/port/db/password.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# backend/docker-compose.yml publishes Redis for remote workers. In production,
# set REDIS_PASSWORD and restrict REDIS_BIND/6379 to worker IPs in the firewall.
REDIS_BIND=127.0.0.1
REDIS_KEY_PREFIX=maimai:
BULLMQ_PREFIX=
DXNET_DISPATCH_SWEEP_INTERVAL_MS=30000

# Music data sync
MUSIC_DATA_URL=https://www.diving-fish.com/api/maimaidxprober/music_data
# Default: every 30 minutes
MUSIC_SYNC_CRON=0 */30 * * * *
SCHEDULER_LEASE_TTL_MS=90000
SCHEDULER_LEASE_RENEW_INTERVAL_MS=30000
SCHEDULER_ABORT_GRACE_MS=120000
MUSIC_SYNC_HARD_TIMEOUT_MS=300000
CATALOG_SYNC_HARD_TIMEOUT_MS=1500000
COVER_SYNC_HARD_TIMEOUT_MS=1500000
COVER_FORCE_SYNC_HARD_TIMEOUT_MS=3600000

# Auth
AUTH_JWT_SECRET=change-me

# WebAuthn / Passkey. RP ID is the frontend host, not the API host.
WEBAUTHN_RP_NAME=maimai Score Hub
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
TRUST_PROXY_HOPS=0

# Admin password for /admin page access
ADMIN_PASSWORD=

# Skip auth validation (for development only)
# When true, any friendCode can login without friend request verification
SKIP_AUTH=false

# Auto Update Settings
# Cron expression for score hash sweeps (default: every minute)
AUTO_UPDATE_CRON=*/1 * * * *
AUTO_UPDATE_HOT_INTERVAL_MS=900000
AUTO_UPDATE_WARM_INTERVAL_MS=1800000
AUTO_UPDATE_COLD_INTERVAL_MS=3600000
AUTO_UPDATE_RIVAL_BATCH_LIMIT=480
AUTO_UPDATE_MAP_BATCH_LIMIT=120
AUTO_UPDATE_TARGETED_FCFS_ENABLED=false
AUTO_UPDATE_FCFS_COOLDOWN_MS=1800000
AUTO_UPDATE_FCFS_CLAIM_TIMEOUT_MS=300000
AUTO_UPDATE_SETTLED_FULL_UPDATE_BATCH_LIMIT=12
AUTO_UPDATE_SETTLED_FULL_UPDATE_MAX_ACTIVE=12
AUTO_UPDATE_SETTLED_FULL_UPDATE_CLAIM_TIMEOUT_MS=300000
AUTO_UPDATE_DAILY_FULL_UPDATE_HOUR=2
AUTO_UPDATE_DAILY_FULL_UPDATE_BATCH_LIMIT=4
AUTO_UPDATE_DAILY_FULL_UPDATE_MAX_ACTIVE=8
AUTO_UPDATE_DAILY_FULL_UPDATE_RETRY_MS=600000
AUTO_UPDATE_DAILY_FULL_UPDATE_MAX_ATTEMPTS=3
AUTO_UPDATE_DAILY_FULL_UPDATE_CLAIM_TIMEOUT_MS=300000
AUTO_UPDATE_SWEEP_LEASE_TTL_MS=90000
AUTO_UPDATE_SWEEP_LEASE_RENEW_INTERVAL_MS=30000
AUTO_UPDATE_SWEEP_HARD_TIMEOUT_MS=600000
AUTO_UPDATE_SWEEP_ABORT_GRACE_MS=180000

# Observability / ClickHouse
# Local dev can point to the 101 ClickHouse instance; see
# docs/log-monitor-refactor/dev-testing.md.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_ENV=dev
OBSERVABILITY_INSTANCE=local-backend
CLICKHOUSE_URL=http://192.168.1.101:8123
CLICKHOUSE_DATABASE=maimai_observability
CLICKHOUSE_USER=maimai_dev_writer
CLICKHOUSE_PASSWORD=
CLICKHOUSE_FLUSH_INTERVAL_MS=3000
CLICKHOUSE_MAX_BATCH_ROWS=1000
CLICKHOUSE_MAX_BUFFERED_ROWS=50000
